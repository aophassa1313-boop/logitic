    <script>
        if (typeof ChartDataLabels !== 'undefined') Chart.register(ChartDataLabels);

        let currentUser = null;
        let dashboardRawData = {};
        let currentTableMatrix = []; 
        let currentActiveSheet = 'dashboard';
        let demandChartInstance = null, inventoryChartInstance = null, vehicleUsageChartInstance = null;

        const cardConfig = {
            'ทะเบียนรับหนังสือ': { icon: 'fa-inbox', color: 'bg-indigo-600' },
            'เสนอความต้องการ': { icon: 'fa-file-signature', color: 'bg-blue-600' },
            'ส่งซ่อม จำหน่าย': { icon: 'fa-screwdriver-wrench', color: 'bg-amber-500' },
            'ขึ้นบัญชีคุม': { icon: 'fa-clipboard-list', color: 'bg-emerald-600' },
            'ยานพาหนะ': { icon: 'fa-car-side', color: 'bg-slate-700' },
            'เบิก สป.3': { icon: 'fa-truck-droplet', color: 'bg-cyan-600' },
            'จำหน่าย สป.3': { icon: 'fa-receipt', color: 'bg-rose-600' },
            'ทะเบียนหนังสือออก': { icon: 'fa-paper-plane', color: 'bg-purple-600' }
        };

        function showLoading(text) { document.getElementById('loadingText').innerText = text; document.getElementById('loadingOverlay').classList.replace('hidden', 'flex'); }
        function hideLoading() { document.getElementById('loadingOverlay').classList.replace('flex', 'hidden'); }
        function isRowEmpty(row) { return !row || !Array.isArray(row) || row.every(cell => cell === null || cell === undefined || cell.toString().trim() === ''); }

        function formatCurrency(val) {
            if (!val && val !== 0) return '';
            let num = parseFloat(val.toString().replace(/,/g, ''));
            if (isNaN(num)) return val;
            return num.toLocaleString('th-TH', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
        }

        function parseThaiDate(dateStr) {
            if(!dateStr) return null;
            const cleanStr = dateStr.toString().trim();
            const parts = cleanStr.includes('/') ? cleanStr.split('/') : cleanStr.split('-');
            if(parts.length !== 3) return null;
            const day = parseInt(parts[0], 10);
            const month = parseInt(parts[1], 10) - 1;
            let year = parseInt(parts[2], 10);
            if(year > 2400) year -= 543;
            if(year < 100) year += 2000;
            return new Date(year, month, day);
        }

        function toggleSidebar() { document.getElementById('sidebar').classList.toggle('-translate-x-full'); document.getElementById('sidebarOverlay').classList.toggle('hidden'); }

        function handleLogin(e) {
            e.preventDefault();
            const memberId = document.getElementById('memberId').value.trim();
            showLoading('กำลังตรวจสอบความถูกต้อง...');
            google.script.run.withSuccessHandler(res => {
                hideLoading();
                if(res.success) {
                    currentUser = res.user;
                    document.getElementById('userNameDisplay').innerText = currentUser.name;
                    document.getElementById('userAvatar').innerText = currentUser.name.charAt(0);
                    document.getElementById('loginScreen').classList.add('hidden');
                    document.getElementById('mainApp').classList.remove('hidden');
                    loadDashboardData();
                } else Swal.fire('Error', res.message, 'error');
            }).authenticateUser(memberId);
        }

        function logout() { Swal.fire({ title: 'ต้องการออกจากระบบใช่หรือไม่?', icon: 'question', showCancelButton: true }).then(r => { if(r.isConfirmed) location.reload(); }); }

        function switchView(view) {
            currentActiveSheet = view;
            document.querySelectorAll('.nav-link').forEach(el => el.classList.remove('bg-blue-600'));
            const active = Array.from(document.querySelectorAll('.nav-link')).find(el => el.innerText.includes(view));
            if(active) active.classList.add('bg-blue-600');
            document.querySelectorAll('.view-section').forEach(el => el.classList.add('hidden'));
            
            if(view === 'dashboard') {
                document.getElementById('pageTitle').innerText = 'แดชบอร์ดสรุปผล';
                document.getElementById('view-dashboard').classList.remove('hidden');
                loadDashboardData();
            } else {
                document.getElementById('pageTitle').innerText = view;
                document.getElementById('currentTableName').innerText = `ฐานข้อมูล: ${view}`;
                document.getElementById('view-table').classList.remove('hidden');
                loadTableData(view);
            }
            if (window.innerWidth < 768) toggleSidebar();
        }

        function loadDashboardData() {
            google.script.run.withSuccessHandler(data => { 
                dashboardRawData = data; 
                renderDashboard(data); 
            }).getDashboardSummary();
        }

        function refreshDashboard() { loadDashboardData(); }
        function refreshCurrentTable() { if(currentActiveSheet !== 'dashboard') loadTableData(currentActiveSheet); }

        function applyDateFilter() {
            const startVal = document.getElementById('startDate').value;
            const endVal = document.getElementById('endDate').value;
            if(!startVal && !endVal) return;
            
            const filterStart = startVal ? new Date(startVal) : new Date('1900-01-01');
            const filterEnd = endVal ? new Date(endVal) : new Date('2100-01-01');
            filterEnd.setHours(23,59,59);

            let filteredData = {};
            for (let sheet in dashboardRawData) {
                const sheetData = dashboardRawData[sheet];
                const header = sheetData[0];
                const dateColIndex = header.findIndex(h => h && (h.toString().trim() === 'วันที่' || h.toString().toLowerCase().includes('date') || h.toString().trim() === 'ลงวันที่'));
                
                if (dateColIndex === -1) { filteredData[sheet] = sheetData; continue; }
                
                filteredData[sheet] = [header];
                for (let i = 1; i < sheetData.length; i++) {
                    if (isRowEmpty(sheetData[i])) continue;
                    const rowDate = parseThaiDate(sheetData[i][dateColIndex]);
                    if (rowDate && rowDate >= filterStart && rowDate <= filterEnd) { filteredData[sheet].push(sheetData[i]); }
                }
            }
            renderDashboard(filteredData);
        }

        function resetFilter() {
            document.getElementById('startDate').value = '';
            document.getElementById('endDate').value = '';
            renderDashboard(dashboardRawData);
        }

        function renderDashboard(data) {
            const container = document.getElementById('dashboardStats');
            container.innerHTML = '';
            Object.keys(cardConfig).forEach(sheet => {
                let count = data[sheet] ? data[sheet].filter((r,i) => i > 0 && !isRowEmpty(r)).length : 0;
                const cfg = cardConfig[sheet];
                container.innerHTML += `
                    <div class="bg-white rounded-xl p-5 shadow-sm border border-gray-100 flex items-center gap-4 transition hover:shadow-md cursor-pointer" onclick="switchView('${sheet}')">
                        <div class="w-12 h-12 rounded-full ${cfg.color} text-white flex items-center justify-center text-xl"><i class="fa-solid ${cfg.icon}"></i></div>
                        <div><p class="text-sm text-gray-500">${sheet}</p><h4 class="text-xl font-bold">${count.toLocaleString()} รายการ</h4></div>
                    </div>`;
            });
            renderIncomingSummary(data['ทะเบียนรับหนังสือ']);
            renderCharts(data);
        }

        function renderIncomingSummary(data) {
            const tbody = document.getElementById('incomingSummaryBody');
            const countBadge = document.getElementById('incomingTodayCount');
            tbody.innerHTML = '';
            if(!data || data.length <= 1) {
                if(countBadge) countBadge.innerText = '0';
                return;
            }
            
            const h = data[0];
            const desired = ['เลขทะเบียนรับ', 'วันที่', 'เวลา', 'ที่หนังสือ', 'เรื่อง', 'จาก', 'ความเร่งด่วน'];
            const indices = desired.map(d => h.findIndex(head => head && (head.toString().trim() === d || (d === 'ที่หนังสือ' && head.toString().trim() === 'ที่'))));
            
            const dateColIdx = h.findIndex(head => head && head.toString().trim() === 'วันที่');

            const now = new Date();
            const todayYear = now.getFullYear();
            const todayMonth = now.getMonth();
            const todayDate = now.getDate();

            let rows = data.slice(1).filter(r => !isRowEmpty(r));
            
            // กรองข้อมูลเฉพาะของวันนี้ (หากไม่มีการใช้ตัวกรองช่วงวันที่ด้านบน)
            const globalStart = document.getElementById('startDate').value;
            if (!globalStart) {
                if (dateColIdx !== -1) {
                    rows = rows.filter(r => {
                        const rowDateStr = (r[dateColIdx] || '').toString().trim();
                        if (!rowDateStr) return false;
                        const rowDate = parseThaiDate(rowDateStr);
                        if (!rowDate) return false;
                        return rowDate.getFullYear() === todayYear && rowDate.getMonth() === todayMonth && rowDate.getDate() === todayDate;
                    });
                }
            }

            if(countBadge) countBadge.innerText = rows.length.toLocaleString();

            if(rows.length === 0) {
                tbody.innerHTML = `<tr><td colspan="7" class="px-3 py-6 text-center text-gray-500 italic">ไม่พบรายการหนังสือรับ</td></tr>`;
                return;
            }

            rows.forEach(row => {
                const tr = document.createElement('tr');
                tr.className = "divide-x divide-gray-200 border-b hover:bg-gray-50 transition";
                indices.forEach(idx => {
                    const td = document.createElement('td');
                    td.className = "px-3 py-2 border border-gray-400 text-sm";
                    td.innerText = row[idx] || '';
                    tr.appendChild(td);
                });
                tbody.appendChild(tr);
            });
        }

        function renderCharts(data) {
            let demandStatusCounts = {};
            if(data['เสนอความต้องการ'] && data['เสนอความต้องการ'].length > 1) {
                const sheetData = data['เสนอความต้องการ'];
                const statusIdx = sheetData[0].findIndex(h => h && h.toString().trim() === 'สถานะ');
                if(statusIdx !== -1) {
                    sheetData.slice(1).forEach(r => {
                        if (isRowEmpty(r)) return;
                        let status = (r[statusIdx] || 'ไม่ระบุ').toString().trim();
                        demandStatusCounts[status] = (demandStatusCounts[status] || 0) + 1;
                    });
                }
            }
            renderDemandChart(Object.keys(demandStatusCounts), Object.values(demandStatusCounts));

            let inventoryLabels = []; let inventoryData = [];
            if(data['คลัง สป.3'] && data['คลัง สป.3'].length > 1) {
                const sheetData = data['คลัง สป.3'];
                const itemIdx = sheetData[0].findIndex(h => h && h.toString().trim() === 'รายการ');
                const qtyIdx = sheetData[0].findIndex(h => h && h.toString().trim() === 'จำนวนคงคลัง');
                sheetData.slice(1).forEach(r => {
                    if (isRowEmpty(r)) return;
                    inventoryLabels.push(r[itemIdx] || 'ไม่ระบุ');
                    inventoryData.push(parseFloat(r[qtyIdx]?.toString().replace(/,/g,'')) || 0);
                });
            }
            renderInventoryChart(inventoryLabels, inventoryData);

            let vLabels = []; let vData = [];
            if(data['ยานพาหนะ'] && data['ยานพาหนะ'].length > 1) {
                const sheetData = data['ยานพาหนะ'];
                const headers = sheetData[0];
                const plateIdx = headers.findIndex(h => h && h.toString().trim() === 'ทะเบียนจักร');
                const civPlateIdx = headers.findIndex(h => h && h.toString().trim() === 'ทะเบียนพลเรือน');
                const usageIdx = headers.findIndex(h => h && h.toString().trim() === 'การใช้งาน');
                
                sheetData.slice(1).forEach(r => {
                    if (isRowEmpty(r)) return;
                    const milPlate = r[plateIdx] || '-';
                    const civPlate = r[civPlateIdx] || '-';
                    vLabels.push(`${milPlate} (${civPlate})`);
                    vData.push(parseFloat(r[usageIdx]?.toString().replace(/,/g,'')) || 0);
                });
            }
            renderVehicleUsageChart(vLabels.length ? vLabels : ['ไม่มีข้อมูล'], vData.length ? vData : [0]);
        }

        function renderDemandChart(labels, dataCounts) {
            const ctx = document.getElementById('demandChart').getContext('2d');
            if (demandChartInstance) demandChartInstance.destroy();
            const colors = ['#3b82f6', '#10b981', '#f59e0b', '#ef4444', '#8b5cf6', '#ec4899', '#06b6d4'];
            demandChartInstance = new Chart(ctx, {
                type: 'bar',
                data: { labels: labels, datasets: [{ data: dataCounts, backgroundColor: labels.map((_, i) => colors[i % colors.length]), borderRadius: 6 }] },
                options: {
                    responsive: true, maintainAspectRatio: false,
                    plugins: { legend: { display: false }, datalabels: { display: true, anchor: 'end', align: 'top', font: { weight: 'bold', family: 'Sarabun' } } },
                    scales: { y: { beginAtZero: true, grid: { color: '#f1f5f9' }, ticks: { stepSize: 1 } }, x: { grid: { display: false } } },
                    onClick: (e, elements) => { if (elements.length > 0) openStatusModal(labels[elements[0].index]); }
                }
            });
        }

        function renderInventoryChart(labels, dataCounts) {
            const ctx = document.getElementById('inventoryChart').getContext('2d');
            if (inventoryChartInstance) inventoryChartInstance.destroy();
            inventoryChartInstance = new Chart(ctx, {
                type: 'doughnut',
                data: { labels: labels, datasets: [{ data: dataCounts, backgroundColor: ['#06b6d4', '#f43f5e', '#a855f7', '#14b8a6', '#f97316', '#3b82f6'], borderWidth: 4, borderColor: '#ffffff' }] },
                options: {
                    responsive: true, maintainAspectRatio: false, cutout: '65%',
                    plugins: { 
                        legend: { position: 'bottom', labels: { usePointStyle: true, boxWidth: 6, font: { family: 'Sarabun', size: 10 } } },
                        datalabels: { 
                            display: true, color: '#fff', font: { weight: 'bold', family: 'Sarabun', size: 12 },
                            backgroundColor: 'rgba(0, 0, 0, 0.4)', borderRadius: 4, padding: 4,
                            formatter: (value) => value.toLocaleString()
                        }
                    }
                }
            });
        }

        function renderVehicleUsageChart(labels, dataCounts) {
            const ctx = document.getElementById('vehicleUsageChart').getContext('2d');
            if (vehicleUsageChartInstance) vehicleUsageChartInstance.destroy();
            vehicleUsageChartInstance = new Chart(ctx, {
                type: 'line',
                data: { labels: labels, datasets: [{ data: dataCounts, borderColor: '#10b981', backgroundColor: 'rgba(16,185,129,0.05)', fill: true, tension: 0.4, pointRadius: 4, pointBackgroundColor: '#10b981', borderWidth: 3 }] },
                options: {
                    responsive: true, maintainAspectRatio: false,
                    plugins: { legend: { display: false }, datalabels: { align: 'top', color: '#047857', font: { weight: 'bold', family: 'Sarabun', size: 10 } } },
                    scales: { y: { beginAtZero: true, grid: { color: '#f1f5f9' } }, x: { grid: { display: false } } }
                }
            });
        }

        function openStatusModal(statusName) {
            const targetStatus = statusName.toString().trim();
            document.getElementById('statusModalTitle').innerText = `รายละเอียดสถานะ: ${targetStatus}`;
            const rawData = dashboardRawData['เสนอความต้องการ'];
            if(!rawData || rawData.length < 2) return;
            const headers = rawData[0];
            const statusIdx = headers.findIndex(h => h && h.toString().trim() === 'สถานะ');
            const desired = ['วันที่', 'เรื่อง', 'จาก', 'จำนวน', 'ราคา', 'ความเร่งด่วน', 'สถานะ'];
            let indices = desired.map(c => headers.findIndex(h => h && h.toString().trim() === c)).filter(i => i !== -1);
            let filtered = rawData.slice(1).filter(r => !isRowEmpty(r) && (r[statusIdx] || '').toString().trim() === targetStatus);
            
            const dateColIdx = headers.findIndex(h => h && h.toString().trim() === 'วันที่');
            if(dateColIdx !== -1) {
                filtered.sort((a, b) => (parseThaiDate(b[dateColIdx]) || 0) - (parseThaiDate(a[dateColIdx]) || 0));
            }

            document.getElementById('statusModalHead').innerHTML = `<tr class="bg-blue-900 text-white">${indices.map(i => `<th class="px-3 py-3 text-center border border-gray-400 font-semibold">${headers[i]}</th>`).join('')}</tr>`;
            
            document.getElementById('statusModalBody').innerHTML = filtered.length ? filtered.map((r, i) => {
                return `<tr class="hover:bg-gray-50 transition-all">${indices.map(idx => {
                    let cellValue = r[idx] || '';
                    if (headers[idx]?.toString().includes('ราคา')) cellValue = formatCurrency(cellValue);
                    return `<td class="px-3 py-2 text-sm border border-gray-200">${cellValue}</td>`;
                }).join('')}</tr>`;
            }).join('') : `<tr><td colspan="${indices.length}" class="p-10 text-center italic text-gray-400">ไม่พบข้อมูล</td></tr>`;
            
            document.getElementById('statusModal').classList.remove('hidden');
            document.getElementById('statusModal').classList.add('flex');
        }

        function closeStatusModal() { document.getElementById('statusModal').classList.replace('flex', 'hidden'); }

        function printStatusModal() {
            const now = new Date();
            const printTime = now.toLocaleString('th-TH', { year: 'numeric', month: 'long', day: 'numeric', hour: '2-digit', minute: '2-digit' });
            document.getElementById('actualPrintTime').innerText = printTime;
            document.getElementById('printTitle').innerText = 'รายงาน' + document.getElementById('statusModalTitle').innerText;
            document.body.classList.add('print-modal-active');
            window.print();
            setTimeout(() => { document.body.classList.remove('print-modal-active'); }, 500);
        }

        function loadTableData(sheet) {
            showLoading(`กำลังเรียกข้อมูล ${sheet}...`);
            google.script.run.withSuccessHandler(res => { 
                hideLoading(); 
                currentTableMatrix = res.data; 
                renderTable(sheet, res.data); 
            }).getSheetData(sheet);
        }

        function applyTableFilters() {
            const startVal = document.getElementById('tableFilterStart').value;
            const endVal = document.getElementById('tableFilterEnd').value;
            if(!startVal && !endVal) return;
            
            const filterStart = startVal ? new Date(startVal) : new Date('1900-01-01');
            const filterEnd = endVal ? new Date(endVal) : new Date('2100-01-01');
            filterEnd.setHours(23,59,59);

            const headers = currentTableMatrix[0];
            const dateColIdx = headers.findIndex(h => h && (h.toString().trim() === 'วันที่' || h.toString().trim() === 'ลงวันที่' || h.toString().trim() === 'ส่งวันที่'));
            
            if (dateColIdx === -1) {
                Swal.fire('แจ้งเตือน', 'ตารางนี้ไม่มีคอลัมน์วันที่สำหรับกรองข้อมูล', 'info');
                return;
            }

            const filteredMatrix = [headers];
            for (let i = 1; i < currentTableMatrix.length; i++) {
                if (isRowEmpty(currentTableMatrix[i])) continue;
                const rowDate = parseThaiDate(currentTableMatrix[i][dateColIdx]);
                if (rowDate && rowDate >= filterStart && rowDate <= filterEnd) {
                    filteredMatrix.push(currentTableMatrix[i]);
                }
            }
            renderTable(currentActiveSheet, filteredMatrix, true); 
        }

        function resetTableFilters() {
            document.getElementById('tableFilterStart').value = '';
            document.getElementById('tableFilterEnd').value = '';
            renderTable(currentActiveSheet, currentTableMatrix);
        }

        function renderTable(sheet, matrix, isFiltered = false) {
            const thead = document.getElementById('tableHead');
            const tbody = document.getElementById('tableBody');
            if(!matrix || matrix.length === 0) return;
            
            const headers = matrix[0];
            let displayIdx = [];
            
            if (sheet === 'ทะเบียนรับหนังสือ') {
                ['เลขทะเบียนรับ', 'วันที่', 'เวลา', 'ที่หนังสือ', 'เรื่อง', 'จาก', 'ความเร่งด่วน'].forEach(d => {
                    let idx = headers.findIndex(h => h && (h.toString().trim() === d || (d === 'ที่หนังสือ' && h.toString().trim() === 'ที่') || (d === 'วันที่' && h.toString().trim() === 'ลงวันที่')));
                    if (idx !== -1) displayIdx.push(idx);
                });
            } else if (sheet === 'ทะเบียนหนังสือออก') {
                ['วันที่', 'ที่หนังสือ', 'เรื่อง', 'ประเภท', 'ไปยัง', 'ส่งวันที่', 'ชื่อ-สกุล'].forEach(d => {
                    let idx = headers.findIndex(h => h && (h.toString().trim() === d || (d === 'ที่หนังสือ' && h.toString().trim() === 'ที่')));
                    if (idx !== -1) displayIdx.push(idx);
                });
            } else if (sheet === 'จำหน่าย สป.3') {
                displayIdx = headers.map((_, i) => i).filter(i => (headers[i]||'').toString().trim() !== 'ประเภท สป.3');
            } else {
                displayIdx = headers.map((_, i) => i);
            }

            thead.innerHTML = `<tr class="bg-blue-900 text-white">` + 
                             displayIdx.map(i => `<th class="px-4 py-3 border border-blue-800 text-center font-semibold whitespace-nowrap">${headers[i]}</th>`).join('') + 
                             `<th class="px-4 py-3 border border-blue-800 text-center action-cell hide-on-print">จัดการ</th></tr>`;
            
            let rows = matrix.slice(1).filter(r => !isRowEmpty(r));
            
            const dateSortIdx = headers.findIndex(h => h && (h.toString().trim() === 'วันที่' || h.toString().trim() === 'ลงวันที่'));
            if(dateSortIdx !== -1) {
                rows.sort((a, b) => (parseThaiDate(b[dateSortIdx]) || 0) - (parseThaiDate(a[dateSortIdx]) || 0));
            }

            tbody.innerHTML = rows.map((row, i) => {
                const originalRowIndex = currentTableMatrix.findIndex(r => r === row);
                const cells = displayIdx.map(idx => {
                    let val = row[idx] || '';
                    const hText = headers[idx]?.toString().trim() || '';
                    if (hText.includes('ราคา')) val = formatCurrency(val);
                    return `<td class="px-4 py-3 border border-gray-200" data-col-index="${idx}">${val}</td>`;
                }).join('');
                return `<tr class="border-b hover:bg-gray-50 transition" data-row-index="${originalRowIndex}">
                            ${cells}
                            <td class="px-4 py-3 border border-gray-200 text-center action-cell hide-on-print">
                                <button onclick="toggleEdit(this, '${sheet}')" class="text-blue-600 bg-blue-50 px-3 py-1.5 rounded-lg hover:bg-blue-600 hover:text-white transition-all text-xs font-bold shadow-sm">
                                    <i class="fa-solid fa-edit"></i> แก้ไข
                                </button>
                            </td>
                        </tr>`;
            }).join('');
            
            if(rows.length === 0) {
                tbody.innerHTML = `<tr><td colspan="${displayIdx.length + 1}" class="p-10 text-center italic text-gray-400">ไม่พบข้อมูลตามเงื่อนไขที่ระบุ</td></tr>`;
            }
        }

        function toggleEdit(btn, sheet) {
            const tr = btn.closest('tr');
            const isEditing = tr.classList.contains('editable-row');
            const cells = tr.querySelectorAll('td:not(.action-cell)');
            const headerCells = Array.from(document.querySelectorAll('#tableHead th')).map(th => th.innerText.trim());

            if (!isEditing) {
                tr.classList.add('editable-row');
                cells.forEach(td => {
                    td.contentEditable = "true";
                    const colIdxInRow = Array.from(tr.cells).indexOf(td);
                    const hText = headerCells[colIdxInRow] || '';
                    if (hText.includes('ราคา')) td.innerText = td.innerText.replace(/,/g, '');
                });
                btn.innerHTML = `<i class="fa-solid fa-save"></i> บันทึก`;
                btn.classList.replace('text-blue-600', 'text-white');
                btn.classList.replace('bg-blue-50', 'bg-emerald-600');
            } else {
                saveRow(tr, sheet, btn, headerCells);
            }
        }

        function saveRow(tr, sheet, btn, headerCells) {
            const rowIdx = parseInt(tr.getAttribute('data-row-index'));
            const cells = tr.querySelectorAll('td:not(.action-cell)');
            let promises = [];
            showLoading('กำลังบันทึกข้อมูล...');
            
            cells.forEach(td => {
                const colIdxInSheet = parseInt(td.getAttribute('data-col-index'));
                const val = td.innerText.trim();
                promises.push(new Promise((resolve) => {
                    google.script.run.withSuccessHandler(() => resolve()).updateCell(sheet, rowIdx, colIdxInSheet, val.replace(/,/g, ''));
                }));
            });

            Promise.all(promises).then(() => {
                hideLoading();
                tr.classList.remove('editable-row');
                cells.forEach(td => {
                    td.contentEditable = "false";
                    const colIdxInRow = Array.from(tr.cells).indexOf(td);
                    const hText = headerCells[colIdxInRow] || '';
                    if (hText.includes('ราคา')) td.innerText = formatCurrency(td.innerText);
                });
                btn.innerHTML = `<i class="fa-solid fa-edit"></i> แก้ไข`;
                btn.classList.replace('bg-emerald-600', 'bg-blue-50');
                btn.classList.replace('text-white', 'text-blue-600');
                Swal.fire({ toast: true, position: 'top-end', icon: 'success', title: 'จัดเก็บเรียบร้อย', showConfirmButton: false, timer: 1500 });
                loadDashboardDataSilent();
            });
        }

        function loadDashboardDataSilent() { google.script.run.withSuccessHandler(d => dashboardRawData = d).getDashboardSummary(); }

        function searchTable() {
            const filter = document.getElementById("tableSearchInput").value.toLowerCase();
            const trs = document.getElementById("tableBody").getElementsByTagName("tr");
            for (let tr of trs) {
                let found = Array.from(tr.cells).some(td => td.innerText.toLowerCase().includes(filter));
                tr.style.display = found ? "" : "none";
            }
        }

        function searchDashboardTable() {
            const filter = document.getElementById("dashboardSearchInput").value.toLowerCase();
            const trs = document.getElementById("incomingSummaryBody").getElementsByTagName("tr");
            for (let tr of trs) {
                let found = Array.from(tr.cells).some(td => td.innerText.toLowerCase().includes(filter));
                tr.style.display = found ? "" : "none";
            }
        }

        function searchModalTable() {
            const filter = document.getElementById("modalSearchInput").value.toLowerCase();
            const trs = document.getElementById("statusModalBody").getElementsByTagName("tr");
            for (let tr of trs) {
                let found = Array.from(tr.cells).some(td => td.innerText.toLowerCase().includes(filter));
                tr.style.display = found ? "" : "none";
            }
        }

        function prepareAndPrint(title) {
            const now = new Date();
            const printTime = now.toLocaleString('th-TH', { year: 'numeric', month: 'long', day: 'numeric', hour: '2-digit', minute: '2-digit' });
            document.getElementById('actualPrintTime').innerText = printTime;
            document.getElementById('printTitle').innerText = 'รายงาน' + title;
            
            document.body.classList.remove('print-incoming-summary', 'print-main-table');

            // แยกประเภทการพิมพ์เพื่อให้ CSS ซ่อนตารางที่ไม่เกี่ยวข้องได้อย่างถูกต้อง
            if (title.includes('สรุปทะเบียนรับหนังสือ')) {
                document.body.classList.add('print-incoming-summary');
            } else {
                document.body.classList.add('print-main-table');
            }
            
            window.print();
        }
    </script>
</body>
</html>
